PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/barangay_db
JWT_SECRET=change-this-secret
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5000
# Optional comma-separated tunnel host suffixes allowed in development CORS
# DEV_TUNNEL_HOSTS=example-tunnel-domain.com

# Google reCaptcha v3
# Get these keys from https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Email notifications: configure Brevo API OR SMTP.
# BREVO_API_KEY=
# EMAIL_FROM=Barangay Irawan <verified-sender@example.com>
# EMAIL_REPLY_TO=reply@example.com
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=

# SMS notifications. Keep API tokens server-side; never use VITE_ prefixes.
# SMS_ENABLED=true
# SMS_PROVIDER=iprog
# IPROG_API_TOKEN=
# Optional IPROG provider route (0, 1, or 2). Leave blank for the default.
# IPROG_SMS_PROVIDER=
# Optional override; normally leave unchanged.
# IPROG_SMS_ENDPOINT=https://www.iprogsms.com/api/v1/sms_messages

# For local development without spending SMS credits:
# SMS_PROVIDER=mock

# Twilio alternative:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Use either TWILIO_NUMBER or TWILIO_MESSAGING_SERVICE_SID.
# TWILIO_NUMBER=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=

# Permanent upload storage (recommended for Render deployments).
# Without S3-compatible storage or a Render Persistent Disk mounted at
# /app/uploads, uploaded images and documents are lost on every redeploy.
# AWS S3:
# S3_BUCKET=
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3-compatible providers (Cloudflare R2, Backblaze B2, DigitalOcean Spaces):
# S3_ENDPOINT=https://your-provider-endpoint.example.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
